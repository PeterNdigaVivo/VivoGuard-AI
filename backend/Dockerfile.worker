# =====================================================================
# Worker image (~1.5 GB CPU, ~5 GB GPU)
#
# Carries everything the AI inference + training pipeline needs:
#   torch (CPU-only by default) + ultralytics + opencv-headless + ffmpeg.
#
# Build args:
#   GPU=true    → installs CUDA-enabled torch wheels (~5 GB image)
#   GPU=false   → installs CPU-only torch wheels      (~1.5 GB image)
#
# Build:
#   docker build --build-arg GPU=false -t vivoguard/worker -f backend/Dockerfile.worker backend/
#   docker build --build-arg GPU=true  -t vivoguard/worker-gpu ...
# =====================================================================
ARG GPU=false
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ffmpeg curl libgl1 libglib2.0-0 tzdata \
 && ln -fs /usr/share/zoneinfo/Africa/Nairobi /etc/localtime \
 && echo "Africa/Nairobi" > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

# Match the api image's default TZ so Celery beat ticks and logs all
# read in EAT. Overridable via the TZ env var in docker-compose.yml.
ENV TZ=Africa/Nairobi

WORKDIR /app

# Install the API-side deps first (worker re-uses app.* models, db, etc).
COPY requirements.api.txt requirements.api.txt
RUN pip install --upgrade pip && pip install -r requirements.api.txt

# Functional smoke test — see Dockerfile.api. The worker imports
# app.auth.security indirectly, so any password-hash regression breaks
# the worker too. Catch it at build time.
RUN python - <<'PY'
import bcrypt, sys
SENTINEL = b"VivoGuard smoke test \xe2\x9c\x94"
try:
    h = bcrypt.hashpw(SENTINEL, bcrypt.gensalt(rounds=4))
    assert bcrypt.checkpw(SENTINEL, h), "verify mismatch"
except Exception as e:
    sys.exit(f"\n*** BUILD FAILED: bcrypt smoke test failed ({e}). ***\n")
print(f"bcrypt OK ({bcrypt.__version__}) — hash/verify round-trip works")
PY

# AI deps. CPU-only torch index is much smaller and avoids pulling CUDA
# runtime libs when GPU is not available.
COPY requirements.worker.txt requirements.worker.txt
RUN if [ "$GPU" = "true" ]; then \
        pip install -r requirements.worker.txt ; \
    else \
        pip install --extra-index-url https://download.pytorch.org/whl/cpu \
                    -r requirements.worker.txt ; \
    fi

COPY app    ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Default command runs the Celery worker. The streamer service overrides
# with its own entrypoint via docker-compose.
CMD ["celery", "-A", "app.tasks.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2"]

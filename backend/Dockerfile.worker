# =====================================================================
# Worker image (~1.5 GB CPU, ~5 GB GPU)
#
# Carries everything the AI inference + training pipeline needs:
#   torch (CPU-only by default) + ultralytics + opencv-headless + ffmpeg.
#
# Build args:
#   GPU_BACKEND=cpu    → CPU-only torch + ONNX Runtime (default, ~1.5 GB)
#   GPU_BACKEND=cuda   → CUDA 12.4 torch + TensorRT     (~5 GB)
#   GPU_BACKEND=rocm   → ROCm 6.2 torch (PyTorch HIP)
#   GPU_BACKEND=mps    → torch + CoreML tools (Apple Silicon hosts)
#   GPU_BACKEND=intel  → CPU torch + OpenVINO
#
# Each backend installs requirements.worker.base.txt PLUS
# requirements.worker.${GPU_BACKEND}.txt (which pins the right torch
# wheel + index). Runtime hardware detection lives in
# backend/app/ai/env_config.py.
#
# Build:
#   docker build --build-arg GPU_BACKEND=cpu  -t vivoguard/worker     -f backend/Dockerfile.worker backend/
#   docker build --build-arg GPU_BACKEND=cuda -t vivoguard/worker-gpu ...
# =====================================================================
ARG GPU_BACKEND=cpu
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ffmpeg curl libgl1 libglib2.0-0 tzdata \
 && ln -fs /usr/share/zoneinfo/Africa/Nairobi /etc/localtime \
 && echo "Africa/Nairobi" > /etc/timezone \
 && rm -rf /var/lib/apt/lists/*

# Match the api image's default TZ so Celery beat ticks and logs all
# read in EAT. Overridable via the TZ env var in docker-compose.yml.
ENV TZ=Africa/Nairobi

WORKDIR /app

# Install the API-side deps first (worker re-uses app.* models, db, etc).
COPY requirements.api.txt requirements.api.txt
RUN pip install --upgrade pip && pip install -r requirements.api.txt

# Functional smoke test — see Dockerfile.api. The worker imports
# app.auth.security indirectly, so any password-hash regression breaks
# the worker too. Catch it at build time.
RUN python - <<'PY'
import bcrypt, sys
SENTINEL = b"VivoGuard smoke test \xe2\x9c\x94"
try:
    h = bcrypt.hashpw(SENTINEL, bcrypt.gensalt(rounds=4))
    assert bcrypt.checkpw(SENTINEL, h), "verify mismatch"
except Exception as e:
    sys.exit(f"\n*** BUILD FAILED: bcrypt smoke test failed ({e}). ***\n")
print(f"bcrypt OK ({bcrypt.__version__}) — hash/verify round-trip works")
PY

# AI deps. base (backend-agnostic) + the backend-specific file, which
# pins the right torch wheel and index. GPU_BACKEND must name an
# existing requirements.worker.${GPU_BACKEND}.txt (cpu|cuda|rocm|mps|intel).
# Re-declare the ARG after FROM so it's in scope for this build stage.
ARG GPU_BACKEND=cpu
COPY requirements.worker.base.txt           requirements.worker.base.txt
COPY requirements.worker.${GPU_BACKEND}.txt requirements.worker.backend.txt
RUN pip install -r requirements.worker.base.txt -r requirements.worker.backend.txt

COPY app    ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Default command runs the Celery worker. The streamer service overrides
# with its own entrypoint via docker-compose.
CMD ["celery", "-A", "app.tasks.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2"]

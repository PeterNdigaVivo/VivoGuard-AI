# =====================================================================
# VivoGuard AI — environment template
# Copy to `.env` (in the same directory as docker-compose.yml) and fill in.
# Anything ending in _PASSWORD / _SECRET / _TOKEN must be unique per deploy.
# =====================================================================

# ---- Core ----
APP_ENV=production            # production | development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TIMEZONE=UTC

# ---- Auth (single-tenant JWT) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30
ODOO_WEBHOOK_SECRET=
ODOO_WEBHOOK_MAX_AGE_SECONDS=300

# ---- Odoo read-only pull integration (disabled until mapped and validated) ----
ODOO_SYNC_ENABLED=false
ODOO_URL=https://your-company.odoo.com
ODOO_DB=
ODOO_USER=
ODOO_API_KEY=
ODOO_MASTER_CRON=15 2 * * *
ODOO_TXN_MINUTES=15
ODOO_HOURS_MAX_AGE_HOURS=48
ODOO_ROSTER_MAX_AGE_HOURS=24
ODOO_ROSTER_RETENTION_DAYS=45
ODOO_REQUEST_TIMEOUT_SECONDS=10
ODOO_PAGE_SIZE=200
ODOO_CONVERSION_MAX=0.60
ODOO_CHANGING_ROOM_GRACE_MINUTES=15
ODOO_CIRCUIT_FAILURES=3
ODOO_CIRCUIT_COOLDOWN_MINUTES=30

# Bootstrap admin (created on first boot if no users exist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-now

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vivoguard
POSTGRES_USER=vivoguard
POSTGRES_PASSWORD=change-me

# ---- Redis (frame buffer + Celery broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ---- MinIO / S3 (clips, thumbnails, model weights, datasets) ----
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET_CLIPS=clips
S3_BUCKET_THUMBS=thumbnails
S3_BUCKET_MODELS=models
S3_BUCKET_DATASETS=datasets
S3_USE_SSL=false

# ---- Encryption key for camera credentials at rest (Fernet, 32-byte url-safe base64) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_FERNET_KEY=

# ── AI Hardware Backend ─────────────────────────────────────
# GPU_BACKEND: which compute backend to use for AI inference
#   cpu    = CPU-only via ONNX Runtime (default, works everywhere)
#   cuda   = NVIDIA GPU via TensorRT (fastest, requires CUDA 12.4+)
#   rocm   = AMD GPU via ROCm 6.2
#   mps    = Apple Silicon via CoreML + Neural Engine
#   intel  = Intel CPU/GPU/NPU via OpenVINO
GPU_BACKEND=cpu

# USE_OPTIMIZED: auto-export model to optimized format for your backend
#   true  = one-time export on first run, then loads cached optimized model (recommended)
#   false = always use raw PyTorch (slower but simpler for debugging)
USE_OPTIMIZED=true

# AI inference frames per second per camera (lower = less CPU, higher = more responsive)
# Recommended: 3 for CPU servers, 5 for GPU servers, 1 for edge/budget servers
INFERENCE_FPS=3
# Bound FFmpeg decoder/filter/encoder native thread pools per camera. Leaving
# this at 1 prevents a 100-camera streamer from creating thousands of threads.
STREAMER_FFMPEG_THREADS=1
# Cap per-camera frame publishing on CPU. Raise only after capacity testing;
# the original per-camera setting remains stored and takes effect on GPU.
STREAMER_MAX_FPS=3
# Saved overrides historically point to full-resolution mainstreams. The
# streamer rewrites only recognised Dahua/Hikvision URL shapes in memory;
# database URLs and credentials remain unchanged for rollback.
STREAMER_PREFER_SUBSTREAM_OVERRIDES=true
# Restart an FFmpeg process if a previously working stream stops publishing.
# The saved mainstream fallback is selected after a preferred-substream exit.
STREAMER_FRAME_STALL_SECONDS=20
# Re-probe unreachable endpoints promptly; long negative caches create blind
# spots after short WAN or NVR interruptions.
STREAMER_RETRY_UNREACHABLE=30

# Each CPU inference child may hold several GiB after loading YOLO/ONNX.
# Increase only after measuring peak RSS and leaving headroom for streamer,
# recorder, Postgres and the OS.
WORKER_INFERENCE_CONCURRENCY=8
# Controlled distribution. Keep 1 for a single worker/GPU. For N > 1,
# provision consumers for every inference.0 ... inference.(N-1) queue first.
INFERENCE_SHARD_COUNT=1
# Comma-separated queues consumed by this worker. Keep "inference" when the
# shard count is 1. Distributed workers use one or more inference.N queues.
INFERENCE_QUEUES=inference
# TensorRT engine batch profile. Leave 1 on CPU/current production; set to the
# largest benchmark candidate (for example 32) before exporting on the GEX44.
INFERENCE_MAX_BATCH_SIZE=1
# Dark launch: a separate GPU service batches live frames but publishes only
# health/capacity telemetry. Enable only on the provisioned GPU host.
INFERENCE_BATCH_SHADOW_ENABLED=false
INFERENCE_BATCH_SHADOW_MODE=true
INFERENCE_BATCH_SIZE=8
INFERENCE_BATCH_REFRESH_SECONDS=30
INFERENCE_BATCH_REQUIRE_CUDA=true
# A shadow canary must remain healthy for two hours before capacity can pass.
# This does not evaluate alert precision/recall and cannot prove the 99% goal.
INFERENCE_WATCHDOG_GRACE_SECONDS=300
INFERENCE_BATCH_HEALTH_MAX_AGE_SECONDS=120
INFERENCE_BATCH_ACCEPTANCE_MIN_UPTIME_SECONDS=7200
INFERENCE_BATCH_ACCEPTANCE_MIN_FRAMES_PER_CAMERA=100
INFERENCE_BATCH_ACCEPTANCE_MAX_P95_MS=400
INFERENCE_BATCH_ACCEPTANCE_MAX_WAIT_SECONDS=2
# Recycle a child after its current task if RSS exceeds 1.5 GiB (value is KiB).
WORKER_INFERENCE_MAX_MEMORY_KIB=1572864
# Native numerical libraries otherwise create a full host-sized thread pool in
# every Celery child. Keep this at 1 on a multi-process CPU deployment; tune it
# only together with WORKER_INFERENCE_CONCURRENCY and measured end-to-end load.
INFERENCE_LIBRARY_THREADS=1
# The compose inference command also uses Celery --disable-prefetch. Do not
# remove it: locally reserved 120-second tasks cannot be overtaken by a newly
# due critical camera even when Redis priority ordering is correct.
# CPU fast lane. Security/life-safety cameras receive short high-priority
# inference slices; a health alert is raised if any fresh critical camera has
# not started inference inside the SLA. This bounds—but does not eliminate—the
# gap until GPU inference is commissioned.
INFERENCE_CRITICAL_SLICE_SECONDS=15
INFERENCE_CRITICAL_REQUEUE_SECONDS=180
INFERENCE_CRITICAL_GAP_SLA_SECONDS=300
INFERENCE_CRITICAL_WATCHDOG_GRACE_SECONDS=60

CUDA_VISIBLE_DEVICES=0
DEFAULT_MODEL=yolov8n.pt      # yolov8n|s|m|l|x.pt
# Training tasks (YOLO.train) still read USE_GPU to pick device="0"|"cpu".
# Inference auto-detects via GPU_BACKEND/env_config — leave false on CPU hosts.
USE_GPU=false

# ── VLM Scene Understanding (Sprint 2.1) ────────────────────
# Cloud Vision-LM adds a plain-English scene description to
# alert-worthy events. Runs async on the alerts queue — never
# blocks inference. Off by default.
VLM_ENABLED=false
VLM_PROVIDER=anthropic
VLM_MODEL=claude-haiku-4-5
VLM_TIMEOUT_SECONDS=10
# Which alert types get a scene description (comma-separated).
VLM_ALERT_TYPES=checkout_dwell,staff_present,trespass,uniform_compliance,shop_open_close
# Anthropic API key — REQUIRED when VLM_ENABLED=true. Keep secret;
# never commit a real value.
ANTHROPIC_API_KEY=
# Optional OpenAI fallback for monitoring-agent reasoning. API billing is
# separate from ChatGPT/Codex subscriptions; keep the key in the secret store.
OPENAI_API_KEY=
AGENTS_LLM_PROVIDER=anthropic
AGENTS_LLM_FALLBACK_PROVIDER=openai
AGENTS_LLM_OPENAI_MODEL=gpt-5.4-mini

# ── Additive incident/evidence foundations (Phase 0) ─────────
# Deploy disabled. Enable the shadow projection only after migration 0040 and
# rollback validation. DELIVERY_OUTBOX_ENABLED creates pending rows but no
# external dispatcher is active in this release.
INCIDENT_FOUNDATIONS_ENABLED=false
DELIVERY_OUTBOX_ENABLED=false

# ── Cross-camera Person Re-ID (Sprint 2.2) ──────────────────
# Matches the SAME person across cameras via appearance embeddings so
# the dashboard counts UNIQUE visitors (not per-camera appearances) and
# can draw customer journeys. Runs on the worker using a CPU ResNet18
# embedder, only every Nth frame per track — negligible load. Needs
# torchvision (already in the CPU worker image). Off by default.
REID_ENABLED=false
# Cosine-similarity cut-off for "same person" (higher = stricter).
# 0.70 suits the HSV colour-histogram encoder.
REID_MATCH_THRESHOLD=0.70
# Seconds a gallery entry survives without a re-match (4h = one trip).
REID_GALLERY_TTL_SECONDS=14400
# Encode 1 of every N frames per track to bound CPU cost.
REID_ENCODE_EVERY_N_FRAMES=5
# Soft cap on gallery entries per store (oldest evicted past this).
REID_MAX_GALLERY_SIZE=500

# ---- Notifications (any channel left blank stays inactive) ----
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@vivoguard.local
SMTP_USE_TLS=true

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Generic outbound webhook (POST JSON of the alert)
WEBHOOK_URL=
WEBHOOK_AUTH_HEADER=          # e.g. "Bearer xxxxx"

# ---- WAN / DDNS ----
DDNS_REFRESH_INTERVAL_SECONDS=300
WAN_RECONNECT_INITIAL_DELAY_SECONDS=5
WAN_RECONNECT_MAX_DELAY_SECONDS=300
WAN_OFFLINE_ALERT_THRESHOLD_SECONDS=120

# ---- Storage paths inside containers (mounted from host) ----
CHECKOUT_ALERT_MINUTES=3
POSITIVE_AGENT_ALERTS_ENABLED=true
# Suppress repeated recovery positives for the same agent during flapping.
POSITIVE_AGENT_ALERT_DEDUP_HOURS=6
RECORDINGS_DIR=/data/recordings
MODELS_DIR=/data/models
DATASETS_DIR=/data/datasets
THUMBNAILS_DIR=/data/thumbnails

# VivoGuard backup settings — copy to /etc/vivoguard/backup.env on the
# server (root-only, chmod 600) and edit there. NEVER commit the real file.
# Every line is optional; the values shown are the defaults.

# Where backups are kept (outside the code folder, root-only).
BACKUP_DIR=/var/backups/vivoguard

# Name of the Postgres container (docker-compose.yml container_name).
PG_CONTAINER=vivoguard-postgres

# How many nightly and Sunday (weekly) copies to keep.
KEEP_DAILY=7
KEEP_WEEKLY=4

# Refuse to start a backup with less free disk than this (MB).
MIN_FREE_MB=2048

# Extra folders to archive with each backup (space-separated). Off by
# default: check sizes first with  du -sh /root/VivoGuard-AI/data/*
# because every nightly copy stores them again.
#INCLUDE_DATA_DIRS="/root/VivoGuard-AI/data/models /root/VivoGuard-AI/data/training"
INCLUDE_DATA_DIRS=

# Off-site copy with rclone (off when empty). Set up the remote first with
# `rclone config` — its credentials stay in rclone's own config file on the
# server, never here. Use an rclone "crypt" remote so the storage provider
# cannot read the backups. Example:  OFFSITE_REMOTE=vivoguard-crypt:backups
OFFSITE_REMOTE=
# Off-site files older than this many days are deleted.
OFFSITE_KEEP_DAYS=35
